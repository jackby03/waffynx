# ============================================================================
# Waffynx — Zero-Trust Multi-Container Environment Template
# Copy to `.env` and populate strong random secrets before starting Compose.
# Never commit `.env` with real credentials (Constitution §2.2).
# ============================================================================

# Published host ports
WAFFYNX_HTTP_PORT=8080
WAFFYNX_HTTPS_PORT=8443
WAFFYNX_API_BIND=127.0.0.1
WAFFYNX_API_PORT=9090
WAFFYNX_UI_DEV_PORT=5173

# Initial reverse-proxy site seeded into PostgreSQL + pushed to Envoy via xDS
WAFFYNX_SITE_HOST=app.example.test
WAFFYNX_SITE_UPSTREAM=backend:80

# Control Room operator credentials & JWT signing secret (>= 32 chars)
WAFFYNX_ADMIN_USER=admin
WAFFYNX_ADMIN_PASSWORD=REPLACE_WITH_STRONG_ADMIN_PASSWORD
WAFFYNX_JWT_SECRET=REPLACE_WITH_32_PLUS_CHAR_RANDOM_JWT_SECRET

# PostgreSQL (Control Plane persistence)
WAFFYNX_POSTGRES_DB=waffynx
WAFFYNX_POSTGRES_USER=waffynx
WAFFYNX_POSTGRES_PASSWORD=REPLACE_WITH_STRONG_POSTGRES_PASSWORD

# Redis (Data Plane sliding-window rate limits, IP jails & hot-reload Pub/Sub)
WAFFYNX_REDIS_PASSWORD=REPLACE_WITH_STRONG_REDIS_PASSWORD
WAFFYNX_REDIS_TIMEOUT_MS=10
WAFFYNX_RATE_LIMIT_ENABLED=true
WAFFYNX_RATE_LIMIT_RPS=100
# Controlled fail-open for rate-limit lookups only (in-memory L7 rules remain active)
WAFFYNX_RATE_LIMIT_FAIL_OPEN=true

# Data Plane inspection guards
WAFFYNX_MAX_BODY_BYTES=1048576
WAFFYNX_SHADOW_MODE=false

# ClickHouse (Observability Plane analytics)
WAFFYNX_CLICKHOUSE_DB=waffynx
WAFFYNX_CLICKHOUSE_USER=waffynx
WAFFYNX_CLICKHOUSE_PASSWORD=REPLACE_WITH_STRONG_CLICKHOUSE_PASSWORD
WAFFYNX_INGEST_BATCH_SIZE=500
WAFFYNX_INGEST_FLUSH_MS=1000
