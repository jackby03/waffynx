# Waffynx Control Plane — Non-Root React SOC Control Room UI Container
ARG BUILDPLATFORM
ARG TARGETPLATFORM

FROM --platform=$BUILDPLATFORM node:22-alpine AS ui-builder
WORKDIR /build/ui
COPY ui/package.json ui/package-lock.json ./
RUN npm ci
COPY ui/ ./
RUN npm run build

FROM --platform=$TARGETPLATFORM nginxinc/nginx-unprivileged:1.27-alpine
COPY deploy/docker/ui-nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=ui-builder /build/ui/dist /usr/share/nginx/html
EXPOSE 8080
